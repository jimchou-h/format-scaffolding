{
  "name": "code-lint-fs",
  "version": "2.0.0",
  "description": "前端编码规范工程化标准脚手架",
  "author": "huangjingzhou <1249293339@qq.com>",
  "homepage": "https://github.com/jimchou-h/format-scaffolding#readme",
  "license": "ISC",
  "bin": "./lib/cli.js",
  "main": "./lib/index.js",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimchou-h/format-scaffolding.git"
  },
  "scripts": {
    "dev": "npm run copyfiles && tsc -w",
    "build": "rimraf lib && npm run copyfiles && tsc",
    "copyfiles": "copyfiles -a -u 1 \"src/config/**\" lib",
    "test": "npm run build && jest --verbose --silent=false",
    "coverage": "npm run build && jest --coverage --silent --forceExit",
    "prepublishOnly": "npm run test"
  },
  "bugs": {
    "url": "https://github.com/jimchou-h/format-scaffolding/issues"
  },
  "devDependencies": {
    "@types/command-exists": "^1.2.0",
    "@types/cross-spawn": "^6.0.2",
    "@types/ejs": "^3.1.0",
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "^7.2.0",
    "@types/lodash": "^4.14.180",
    "@types/node": "^18.19.0",
    "@types/text-table": "^0.2.2",
    "copyfiles": "^2.4.1",
    "jest": "^27.5.1",
    "nyc": "^15.1.0",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.0",
    "chalk": "^4.1.0",
    "command-exists": "^1.2.9",
    "commander": "^6.2.1",
    "commitlint-config-format-scaffolding": "^2.0.0",
    "cross-spawn": "^7.0.3",
    "ejs": "^3.1.5",
    "eslint": "^9.39.0",
    "eslint-config-format-scaffolding": "^2.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.5.0",
    "execa": "^5.0.0",
    "fast-glob": "^3.2.11",
    "fs-extra": "^9.0.1",
    "glob": "^7.1.6",
    "husky": "^9.1.0",
    "inquirer": "^7.3.3",
    "is-docker": "^2.1.1",
    "lodash": "^4.17.20",
    "markdownlint": "^0.25.1",
    "markdownlint-config-format-scaffolding": "^2.0.0",
    "markdownlint-rule-helpers": "^0.13.0",
    "ora": "^5.1.0",
    "prettier": "^3.9.0",
    "strip-ansi": "^6.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-format-scaffolding": "^2.0.0",
    "terminal-link": "^2.1.1",
    "text-table": "^0.2.0"
