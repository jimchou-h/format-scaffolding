{
  "name": "format-scaffolding-vue-demo",
  "private": true,
  "version": "1.1.0",
  "description": "Vue3 + TS 示例，用来验证 code-lint-fs 1.1.0 在 pnpm 下能解析 extends 与引擎",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "scan": "code-lint-fs scan",
    "fix": "code-lint-fs fix",
    "code-lint-fs-scan": "code-lint-fs scan",
    "code-lint-fs-fix": "code-lint-fs fix"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "code-lint-fs": "workspace:*",
    "typescript": "^4.9.5",
    "vite": "^5.4.11",
    "vue-tsc": "^1.8.27"
  },
  "husky": {
    "hooks": {
      "pre-commit": "code-lint-fs commit-file-scan",
      "commit-msg": "code-lint-fs commit-msg-scan"
    }
  }
}